a:2:{s:10:"expires_at";i:1789765764;s:5:"value";a:11:{s:2:"id";s:6:"news_2";s:5:"title";s:60:"Premier League Title Race Heats Up Ahead of Crucial Matchday";s:4:"slug";s:34:"premier-league-title-race-heats-up";s:7:"summary";s:124:"Arsenal and Liverpool remain locked in a tight battle for the top spot as Manchester City closely pursue with games in hand.";s:7:"content";s:164:"With only ten rounds of fixtures remaining, the 2025/26 English Premier League title race is shaping up to be one of the closest battles in recent football history.";s:8:"category";s:8:"Football";s:5:"sport";s:8:"football";s:6:"source";s:15:"Sky Sports News";s:10:"source_url";s:25:"https://www.skysports.com";s:9:"image_url";s:92:"https://images.unsplash.com/photo-1508098682722-e99c43a406b2?w=800&auto=format&fit=crop&q=80";s:12:"published_at";s:19:"2026-09-18 23:09:24";}}