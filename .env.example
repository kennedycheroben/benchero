APP_NAME="Teamora"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/teamora/public
APP_KEY=base64:REPLACE_WITH_OUTPUT_OF__php_-r__echo_base64_encode(random_bytes(32))__
APP_TIMEZONE=Africa/Nairobi

BRAND_NAME="Teamora"
BRAND_TAGLINE="One platform. Every team."
BRAND_SUPPORT_EMAIL="support@teamora.local"
BRAND_CONTACT_EMAIL="hello@teamora.local"
BRAND_COMPANY_NAME="Teamora Inc."
BRAND_COUNTRY="Kenya"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teamora_dev
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=false

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
